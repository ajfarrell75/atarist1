# =============================================================================
#	[m68k-atari-mint]
# =============================================================================

# =============================================================================
#	Link .TOS file directly
# =============================================================================

$(OBJ_DIR)/%.tos: $(CRTSEQ_S_OBJ) $(AGLIB) $(OBJ_DIR)/%.o $(PROJECT_OBJ) | Makefile
	$(LINK) $(LDFLAGS) $(LIBPATHS) \
	$(CRTSEQ_S_OBJ) $(OBJ_DIR)/$*.o $(PROJECT_OBJ) $(AGLIB) $(LIBS) \
	-o $(OBJ_DIR)/$*.tos

# -----------------------------------------------------------------------------
#	Configure user stack size (MiNTlib CRT only!)
# -----------------------------------------------------------------------------
ifeq ($(LINK_MINIMAL),no)
	$(STACK) $(OBJ_DIR)/$*.tos
endif

# -----------------------------------------------------------------------------
ifeq ($(BUILD_CFG),release)
# -----------------------------------------------------------------------------
#	Strip symbols & pack executable
# -----------------------------------------------------------------------------
	$(STRIP) $(OBJ_DIR)/$*.tos
ifeq ($(USE_UPX_PACKER),yes)
	$(HOST_TOOL_DIR)/upx -9 $(OBJ_DIR)/$*.tos
#	$(HOST_TOOL_DIR)/upx -9 --brute --ultra-brute $(OBJ_DIR)/$*.tos
endif
# -----------------------------------------------------------------------------
else
# -----------------------------------------------------------------------------
#	Process symbols to .sym files via NM (minus .locals, interrupts etc)
# -----------------------------------------------------------------------------
ifeq ($(USE_HATARI_DEBUGGING),yes)
	$(NM) -n $(OBJ_DIR)/$*.tos > $(OBJ_DIR)/$*_.sym
	fgrep -v -e ".L" -e " ." -e ".o" -e "/" -e " W " -e " b " -e " d " \
	  -e " w " -e " a " -e "___gnu_compiled_c" -e "gcc2_compiled." \
	  -e " _rcsid"  \
	  -e "_vbi" -e "shifter_vbl" -e "mouse_d" \
	  $(OBJ_DIR)/$*_.sym > $(OBJ_DIR)/$*.sym
	cp $(OBJ_DIR)/$*_.sym $(HATARI_DEBUG_DIR)/.
	cp $(OBJ_DIR)/$*.sym $(HATARI_DEBUG_DIR)/.
endif
# -----------------------------------------------------------------------------
endif # release/debug
# -----------------------------------------------------------------------------

