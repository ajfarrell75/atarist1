# Dockerfile.bionic — la toolchain Linux x86_64 GELÉE de NeoST, dérivée du
# pom1-bionic-builder (même squelette, mêmes pins ; cf. POM1
# packaging/linux/Dockerfile.bionic pour l'historique complet).
#
# POURQUOI : l'AppImage doit se lier à la glibc 2.27 pour tourner de Mint 19.x
# à aujourd'hui (une AppImage n'embarque jamais la glibc — son plancher est
# celui de la machine de build). Donc on compile dans Ubuntu 18.04 (bionic,
# EOL, miroirs apt capricieux) : tout ce qui est flaky (apt, téléchargements)
# est cuit UNE FOIS dans cette image poussée sur ghcr.io ; la release fait un
# simple `docker run`, reproductible par digest.
#
# DIFFÉRENCE avec l'image POM1 (et raison de ne pas la réutiliser telle
# quelle) : POM1 fige g++-9, or Moira — le cœur 68000 de NeoST — exige
# -std=c++20 (std::rotr/rotl, map::contains), option que g++-9 ne connaît pas.
# On installe gcc-11 depuis le même PPA ubuntu-toolchain-r/test. Pas de cc65
# ni python3.8 ici : NeoST n'en a pas besoin au build.
#
# Build + push via .github/workflows/build-bionic-image.yml ; épingler ensuite
# le digest imprimé dans release.yml (job linux-bionic).
FROM ubuntu:18.04

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
# Entrées épinglées + SHA256 (mêmes pins que POM1) : tout téléchargement est
# vérifié — un rebuild récupère des octets identiques ou échoue bruyamment.
ARG CMAKE_VER=3.27.9
ARG CMAKE_SHA256=72b01478eeb312bf1a0136208957784fe55a7b587f8d9f9142a7fc9b0b9e9a28
ARG GLFW_VER=3.3.10
ARG GLFW_SHA256=4ff18a3377da465386374d8127e7b7349b685288cb8e17122f7e1179f73769d5
ARG APPIMAGETOOL_SHA256=b90f4a8b18967545fda78a445b27680a1642f1ef9488ced28b65398f2be7add2
ARG LINUXDEPLOY_SHA256=e87ee0815d109282fdda73e34c2361d64d02b0ffaea3674b18f1fd1f6a687dcf

# --- outillage de base + en-têtes X11/GL -------------------------------------
# Les archives apt de bionic oscillent entre archive.ubuntu.com et
# old-releases.ubuntu.com : réessayer archive d'abord, ne basculer qu'en
# dernier recours. Cette fragilité ne mord qu'au build de CETTE image.
RUN apt_update_retry() { local i; for i in 1 2 3 4; do apt-get update && return 0; echo "[apt] update attempt $i/4 failed; retrying in 15s" >&2; sleep 15; done; return 1; }; \
    if ! apt_update_retry; then \
        echo "[apt] archive.ubuntu.com unreachable — falling back to old-releases" >&2; \
        sed -i -e 's|http://archive.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
               -e 's|http://security.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
            /etc/apt/sources.list; \
        apt_update_retry; \
    fi; \
    apt-get install -y --no-install-recommends \
        ca-certificates gnupg wget curl git make pkg-config \
        file desktop-file-utils xz-utils \
        build-essential software-properties-common \
        libgl1-mesa-dev \
        libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev libxext-dev

# --- gcc-11 (Moira exige -std=c++20 ; le g++-7 de bionic et le g++-9 de POM1
#     ne le connaissent pas) -------------------------------------------------
RUN add-apt-repository -y ppa:ubuntu-toolchain-r/test && apt-get update && \
    apt-get install -y --no-install-recommends gcc-11 g++-11 && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 90 \
                        --slave   /usr/bin/g++ g++ /usr/bin/g++-11 && \
    g++ --version

# --- CMake moderne (bionic livre 3.10 ; NeoST exige >= 3.20) -----------------
RUN wget -qO /tmp/cmake.tar.gz \
        "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VER}/cmake-${CMAKE_VER}-linux-x86_64.tar.gz" && \
    echo "${CMAKE_SHA256}  /tmp/cmake.tar.gz" | sha256sum -c - && \
    mkdir -p /opt/cmake && tar --strip-components=1 -xzf /tmp/cmake.tar.gz -C /opt/cmake && \
    rm -f /tmp/cmake.tar.gz
ENV PATH="/opt/cmake/bin:${PATH}"

# --- GLFW 3.3 depuis les sources → /usr/local (bionic livre 3.2.1) -----------
#     find_package(glfw3) la résout ; linuxdeploy embarque libglfw.so.3.
RUN wget -qO /tmp/glfw.tar.gz \
        "https://github.com/glfw/glfw/archive/refs/tags/${GLFW_VER}.tar.gz" && \
    echo "${GLFW_SHA256}  /tmp/glfw.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/glfw.tar.gz -C /tmp && \
    cmake -S "/tmp/glfw-${GLFW_VER}" -B /tmp/glfw-build \
        -DGLFW_BUILD_EXAMPLES=OFF -DGLFW_BUILD_TESTS=OFF -DGLFW_BUILD_DOCS=OFF \
        -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /tmp/glfw-build -j"$(nproc)" --target install && ldconfig && \
    rm -rf /tmp/glfw.tar.gz "/tmp/glfw-${GLFW_VER}" /tmp/glfw-build

# --- Outils AppImage, extraits → /opt/appimage-tools (cuits, sans FUSE) ------
#     appimagetool d'AppImageKit (l'ANCIEN dépôt) : runtime ELF ET_EXEC +
#     squashfs gzip, accepté par AppImageLauncher — le nouveau
#     AppImage/appimagetool (et le plugin appimage de linuxdeploy) produisent
#     un runtime static-pie ET_DYN rejeté en « type -1 ».
#     make_appimage.sh les trouve via NEOST_APPIMAGE_TOOLS_DIR.
RUN mkdir -p /opt/appimage-tools && cd /opt/appimage-tools && \
    wget -q "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage" -O linuxdeploy.AppImage && \
    echo "${LINUXDEPLOY_SHA256}  linuxdeploy.AppImage" | sha256sum -c - && \
    wget -q "https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage" -O appimagetool.AppImage && \
    echo "${APPIMAGETOOL_SHA256}  appimagetool.AppImage" | sha256sum -c - && \
    chmod +x ./*.AppImage && \
    ./linuxdeploy.AppImage  --appimage-extract >/dev/null && mv squashfs-root linuxdeploy.AppDir && \
    ./appimagetool.AppImage --appimage-extract >/dev/null && mv squashfs-root appimagetool.AppDir && \
    rm -f ./*.AppImage
ENV NEOST_APPIMAGE_TOOLS_DIR=/opt/appimage-tools

WORKDIR /work
