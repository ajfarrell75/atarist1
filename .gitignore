# Artefacts CMake / build local
build/
build-*/
dist/
a.out
_site/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

# Binaires et objets
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.dSYM/
# Ancrés à la RACINE : la règle nue « neost » ignorait AUSSI tout chemin contenant
# un composant de ce nom — dont packaging/android/.../java/net/gistlabs/neost/,
# le paquet Java d'Android (piège trouvé au dry-run d'un commit).
/neost
/neost-headless

# Fichiers locaux de l'emulateur / GUI
imgui.ini
neost.cfg
# Profils de réglages nommés (Configuration → Profiles) : configurations de
# l'utilisateur, au même format que neost.cfg — donc pas plus suivies que lui.
profiles/
*.state
*.ppm
!tests/reference/*.ppm
tests/out/

# ROMs et images disque : tout le contenu de rom/ et disks/ est suivi.

# Disques durs (fenêtre Hard Disks) : les images ACSI pèsent des dizaines de Mo et les
# lecteurs GEMDOS sont remplis par l'utilisateur — seul le mode d'emploi est suivi.
hd/*
!hd/README.md

# OS / editeurs
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python utilise par les outils
__pycache__/
*.py[cod]
.venv/
venv/

# Hatari (référence, non committé)
extern/hatari/
extern/spsdeclib_*/

# capsimg (licence SPS non-commerciale — non redistribuable, non compilé)
extern/capsimg/

# SDL2 (couche plateforme Android, cf. packaging/android/fetch_sdl.sh)
extern/SDL2/

# Assets du paquet Android : copiés depuis roms/ et disks/ par stage_assets.sh
packaging/android/app/src/main/assets/
packaging/android/local.properties
packaging/android/.gradle/
packaging/android/app/build/
packaging/android/app/.cxx/
packaging/android/build/
